PORT=3000
NODE_ENV=development

# Auth
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters

# Postgres (either these or DATABASE_URL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=zomareel
DB_USER=postgres
DB_PASSWORD=

# Single connection string alternative, takes priority when set
# DATABASE_URL=postgresql://postgres:password@localhost:5432/zomareel

# Bind locally by default; set HOST explicitly when deploying
HOST=127.0.0.1
# Remote connections always require certificate-verified TLS
# DB_SSL=true
# DB_SSL_CA=trusted CA certificate with escaped newlines
# Development seed only; never use a real account password
# SEED_PASSWORD=choose-a-unique-password-of-at-least-12-characters

# Supply only to npm run db:migrate; keep owner credentials out of app runtime
# DB_MIGRATION_URL=postgresql://schema_owner:password@localhost:5432/zomareel

# Public origin: exact HTTPS origin without a trailing slash, required in production
# SITE_URL=https://zomareel.example
# Exact production frontend origin when the app is hosted behind Vercel rewrites.
# FRONTEND_ORIGIN=https://your-project.vercel.app
# Only exact IPs/CIDRs of your reverse proxies. Never trust arbitrary forwarded headers.
# TRUSTED_PROXIES=127.0.0.1/32,::1/128
